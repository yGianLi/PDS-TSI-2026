classDiagram

    %% =========================
    %% CLASSES PRINCIPAIS
    %% =========================

    class Banco {
        -nome: String
        -codigo: String
        +abrirConta(cliente: Cliente, tipo: TipoConta): Conta
        +encerrarConta(conta: Conta): void
    }

    class Cliente {
        -cpf: String
        -nome: String
        -endereco: String
        -telefone: String
        -email: String
        +solicitarAberturaConta(): void
        +solicitarEncerramentoConta(): void
    }

    class Funcionario {
        -matricula: String
        -nome: String
        -cargo: String
        +cadastrarCliente(cliente: Cliente): void
        +alterarCadastro(cliente: Cliente): void
        +abrirConta(cliente: Cliente, tipo: TipoConta): Conta
        +encerrarConta(conta: Conta): void
    }

    class CaixaEletronico {
        -numero: String
        -localizacao: String
        +depositar(conta: Conta, valor: double): void
        +sacar(conta: Conta, valor: double): void
        +consultarSaldo(conta: Conta): double
        +emitirExtrato(conta: Conta): Extrato
    }

    %% =========================
    %% CONTAS
    %% =========================

    class Conta {
        <<abstract>>
        -numero: String
        -saldo: double
        -dataAbertura: Date
        -dataEncerramento: Date
        -status: StatusConta
        +depositar(valor: double): void
        +sacar(valor: double): boolean
        +consultarSaldo(): double
        +emitirExtrato(): Extrato
        +encerrar(): void
        +podeSacar(valor: double): boolean
    }

    class ContaComum {
        +podeSacar(valor: double): boolean
    }

    class ContaEspecial {
        -limite: double
        +podeSacar(valor: double): boolean
        +consultarLimite(): double
    }

    class ContaPoupanca {
        -taxaJuros: double
        -dataUltimaMovimentacao: Date
        +calcularJuros(): double
        +aplicarJuros(): void
        +depositar(valor: double): void
        +sacar(valor: double): boolean
    }

    %% =========================
    %% MOVIMENTAÇÕES / EXTRATO
    %% =========================

    class Movimentacao {
        -dataHora: Date
        -valor: double
        -tipo: TipoMovimentacao
        -descricao: String
    }

    class Extrato {
        -dataInicio: Date
        -dataFim: Date
        +gerar(): String
    }

    %% =========================
    %% ENUMERAÇÕES
    %% =========================

    class TipoConta {
        <<enumeration>>
        COMUM
        ESPECIAL
        POUPANCA
    }

    class TipoMovimentacao {
        <<enumeration>>
        DEPOSITO
        SAQUE
        JUROS
    }

    class StatusConta {
        <<enumeration>>
        ATIVA
        ENCERRADA
    }

    %% =========================
    %% HERANÇA
    %% =========================

    Conta <|-- ContaComum
    Conta <|-- ContaEspecial
    Conta <|-- ContaPoupanca

    %% =========================
    %% ASSOCIAÇÕES
    %% =========================

    Banco "1" o-- "0..*" Funcionario : possui
    Banco "1" o-- "0..*" Cliente : cadastra
    Banco "1" o-- "0..*" Conta : administra
    Banco "1" o-- "0..*" CaixaEletronico : disponibiliza

    Cliente "1" -- "0..*" Conta : possui
    Funcionario "1" -- "0..*" Cliente : cadastra/altera
    Funcionario "1" -- "0..*" Conta : abre/encerra

    Conta "1" *-- "0..*" Movimentacao : registra
    Conta "1" --> "0..*" Extrato : gera

    CaixaEletronico ..> Conta : realiza operações
    CaixaEletronico ..> Extrato : emite